---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>👋 Hi, I'm Tzvi Richt</h1>
			<p>
				Welcome to my personal slice of the internet! I am passionate about building great things and sharing what I learn along the way.
			</p>
			<p>
				This is my digital garden where I document my projects, write about my experiences, and showcase my work. Feel free to look around!
			</p>
			
			<h3>What you'll find here:</h3>
			<ul>
				<li>📝 <strong>My Blog:</strong> Articles about my journey, industry insights, and tutorials.</li>
				<li>🚀 <strong>Projects:</strong> A showcase of things I have built.</li>
				<li>📫 <strong>Connect:</strong> Links to my professional profiles.</li>
			</ul>

			<p>
				Want to get in touch? You can find me on <a href="https://www.linkedin.com/in/tzvi-richt-1237ba106" target="_blank">LinkedIn</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
